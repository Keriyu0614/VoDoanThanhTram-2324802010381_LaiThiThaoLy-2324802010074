@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_Layout";
}

<div class="container">
    <div class="row">
        <div class="col s12 m6 offset-m3">
            <h4 class="center-align">@ViewData["Title"]</h4>
            <p class="center-align">Nhập lại mật khẩu mới cho tài khoản của bạn.</p>

            <form method="post" class="form-horizontal">
                <div asp-validation-summary="All" class="text-danger"></div>

                <input asp-for="Input.Code" type="hidden" />

                <div class="row">
                    <div class="input-field col s12">
                        <input asp-for="Input.Email" type="email" class="validate" />
                        <label asp-for="Input.Email">Email</label>
                        <span class="helper-text" data-error="Email không hợp lệ" data-success="Hợp lệ"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <input asp-for="Input.Password" type="password" class="validate" />
                        <label asp-for="Input.Password">Mật khẩu mới</label>
                        <span class="helper-text" data-error="Sai định dạng" data-success="Hợp lệ"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <input asp-for="Input.ConfirmPassword" type="password" class="validate" />
                        <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
                        <span class="helper-text" data-error="Mật khẩu không khớp" data-success="Hợp lệ"></span>
                    </div>
                </div>

                <div class="row center">
                    <button class="btn waves-effect waves-light btn-large" type="submit">
                        Đặt lại mật khẩu
                        <i class="material-icons right">lock_open</i>
                    </button>
                </div>

                <div class="row center">
                    <a asp-page="./Login">Quay lại đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}