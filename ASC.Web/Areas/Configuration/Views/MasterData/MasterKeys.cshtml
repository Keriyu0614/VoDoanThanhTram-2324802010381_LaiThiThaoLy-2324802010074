@model ASC.Web.Areas.Configuration.Models.MasterKeysViewModel
@{
    Layout = "_SecureLayout";
}

<style>
    /* Fix switch alignment to match other input-field height */
    .switch-wrapper {
        margin-top: 28px;
        display: flex;
        align-items: center;
        height: 45px;
    }

        .switch-wrapper label {
            font-size: 0.85rem;
            color: #9e9e9e;
            display: flex;
            align-items: center;
            gap: 8px;
        }
</style>

<div class="row"></div>
<div class="row padding-top-20px padding-left-20px padding-right-20px">
    <div class="row z-depth-3">
        <div class="section white-text padding-left-10px blue-grey lighten-1">
            <h5>Master Keys</h5>
        </div>
        <div class="divider"></div>
        <div class="col s12 padding-bottom-15px">
            @if (Model.MasterKeys != null)
            {
                <table class="highlight centered" id="tblMasterKeys">
                    <thead>
                        <tr>
                            <th data-field="RowKey">Row Key</th>
                            <th data-field="PartitionKey">Partition Key</th>
                            <th data-field="Name">Name</th>
                            <th data-field="IsActive">Is Active</th>
                            <th data-field="IsActiveImg">Is Active</th>
                            <th data-field="Actions">Edit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var masterKey in Model.MasterKeys)
                        {
                            <tr>
                                <td>@masterKey.RowKey</td>
                                <td>@masterKey.PartitionKey</td>
                                <td>@masterKey.Name</td>
                                <td>@masterKey.IsActive</td>
                                <td>
                                    <img src="@(masterKey.IsActive ? "/images/green_tick.png" : "/images/red_cross.png")" />
                                </td>
                                <td>
                                    <i class="small material-icons edit cursor-hand">
                                        mode_edit
                                    </i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="card blue-grey lighten-1">
                    <div class="card-content white-text">
                        <span class="card-title">No Master Keys found!!!</span>
                        <p>
                            No Master Keys found, please add a Master Key to system.
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row"></div>
    <div class="row z-depth-3">
        <div class="col s12 padding-8px">
            <div class="section white-text padding-left-10px blue-grey lighten-1">
                <h5>Master Key Details</h5>
            </div>
            <div class="divider"></div>
            <form asp-controller="MasterData" asp-action="MasterKeys" method="post"
                  class="col s12" id="formMasterKey">
                <div class="row">
                    <input type="hidden" asp-for="IsEdit" />
                    <input type="hidden" asp-for="MasterKeyInContext.PartitionKey" />

                    <div class="input-field col s4">
                        <input asp-for="MasterKeyInContext.RowKey" id="Input_MasterKey_RowKey" readonly />
                        <label asp-for="MasterKeyInContext.RowKey">RowKey</label>
                    </div>

                    <div class="input-field col s4">
                        <input asp-for="MasterKeyInContext.Name" class="validate" />
                        <label asp-for="MasterKeyInContext.Name">Name</label>
                    </div>

                    <div class="col s4 switch-wrapper">
                        <div class="switch">
                            <label>
                                Is Active
                                <input asp-for="MasterKeyInContext.IsActive" type="checkbox" />
                                <span class="lever"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="input-field col s12 right-align">
                        <button class="btn waves-effect waves-light btnSubmit teal"
                                type="submit" name="action">
                            @(Model.IsEdit ? "SAVE" : "CREATE")
                            <i class="material-icons right btnSubmitIcon">@(Model.IsEdit ? "save" : "send")</i>
                        </button>
                        <button class="btn waves-effect waves-light reset red" type="button" name="action">
                            RESET
                        </button>
                    </div>
                    <div class="row col s12 right-align" asp-validation-summary="All">
                    </div>
                </div>
            </form>
            <div class="row"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            if ($('#tblMasterKeys').length) {
                var table = $('#tblMasterKeys').DataTable({
                    'pageLength': 3,
                    'lengthMenu': [[3, 5, 10, -1], [3, 5, 10, 'All']],
                    'autoWidth': false
                });
                $('#tblMasterKeys').css("width", "100%");
                setTimeout(function () {
                    $('select[name="tblMasterKeys_length"]').formSelect();
                }, 300);
                table.column(1).visible(false);
                table.column(3).visible(false);
                $(document).on('click', '.edit', function () {
                    var rowData = table.row($(this).parents('tr')).data();

                    $('#IsEdit').val('True');
                    $('#MasterKeyInContext_RowKey').val(rowData[0]);
                    $('#Input_MasterKey_RowKey').val(rowData[0]);
                    $('#MasterKeyInContext_PartitionKey').val(rowData[1]);
                    $('#MasterKeyInContext_Name').val(rowData[2]);
                    $('#MasterKeyInContext_Name').addClass('valid');
                    var isActive = rowData[3] === 'True' || rowData[3] === true;
                    $('#MasterKeyInContext_IsActive').prop('checked', isActive);
                    $('.btnSubmit').html('SAVE <i class="material-icons right btnSubmitIcon">save</i>');
                    M.updateTextFields();
                    $('html, body').animate({ scrollTop: $('#formMasterKey').offset().top - 20 }, 400);
                });
            }

            $(document).on("click", ".reset", function () {
                $('#formMasterKey')[0].reset();
                $('.btnSubmit').html('CREATE <i class="material-icons right btnSubmitIcon">send</i>');
                $('#IsEdit').val('False');
                $('#MasterKeyInContext_RowKey').val('');
                $('#MasterKeyInContext_PartitionKey').val('');
                $('#Input_MasterKey_RowKey').val('');
                M.updateTextFields();
            });

        });
    </script>
}
