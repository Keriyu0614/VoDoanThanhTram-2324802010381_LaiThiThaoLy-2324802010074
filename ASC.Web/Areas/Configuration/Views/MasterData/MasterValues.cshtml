@model ASC.Web.Areas.Configuration.Models.MasterValuesViewModel
@{
    Layout = "_SecureLayout";
}

<style>
    .switch-wrapper {
        margin-top: 10px;
        display: flex;
        align-items: center;
        height: 45px;
    }

        .switch-wrapper label {
            font-size: 0.85rem;
            color: #9e9e9e;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .select-wrapper input.select-dropdown {
        margin-bottom: 0;
    }
</style>

<div class="row"></div>
<div class="row padding-top-20px padding-left-20px padding-right-20px">
    <div class="row z-depth-3">
        <div class="section white-text padding-left-10px blue-grey lighten-1">
            <h5>Master Values</h5>
        </div>
        <div class="divider"></div>

        <div class="col s4 padding-bottom-15px">
            <select id="ddlMasterKeys" asp-items="@(new SelectList(ViewBag.MasterKeys,"RowKey","PartitionKey"))">
                <option>--Select--</option>
            </select>
            <label>Partition Key</label>
        </div>
        <div class="col s4 offset-s4 padding-bottom-15px right-align">
            <a class="modal-trigger waves-effect waves-light" href="#modal1">
                <img src="~/images/excel.png" />
            </a>
        </div>

        <div class="col s12 padding-bottom-15px">
            <table class="highlight centered" id="tblMasterValues">
                <thead>
                    <tr>
                        <th data-field="RowKey">Row Key</th>
                        <th data-field="PartitionKey">Partition Key</th>
                        <th data-field="Name">Name</th>
                        <th data-field="IsActive">Is Active</th>
                        <th data-field="Actions">Edit</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <div class="row"></div>

    <div class="row z-depth-3">
        <div class="col s12 padding-0px">
            <div class="section white-text padding-left-10px blue-grey lighten-1">
                <h5>Master Value Details</h5>
            </div>
            <div class="divider"></div>
            <form asp-controller="MasterData" asp-action="MasterValues" method="post"
                  class="col s12" id="formMasterValue">
                <div class="row">
                    <input type="hidden" asp-for="IsEdit" />
                    <input type="hidden" asp-for="MasterValueInContext.PartitionKey" />

                    <div class="input-field col s4">
                        <input asp-for="MasterValueInContext.RowKey" id="Input_MasterValue_RowKey" readonly />
                        <label asp-for="MasterValueInContext.RowKey">RowKey</label>
                    </div>

                    <div class="input-field col s4">
                        <select id="Select_MasterValueInContext_PartitionKey"
                                asp-for="MasterValueInContext.PartitionKey"
                                asp-items="@(new SelectList(ViewBag.MasterKeys,"RowKey","PartitionKey"))"
                                required="required">
                            <option value="">--Select--</option>
                        </select>
                        <label>Partition Key</label>
                    </div>

                    <div class="input-field col s4">
                        <input asp-for="MasterValueInContext.Name" class="validate" />
                        <label asp-for="MasterValueInContext.Name">Name</label>
                    </div>
                </div>

                <div class="row" style="margin-top: 10px;">
                    <div class="col s4 switch-wrapper">
                        <div class="switch">
                            <label>
                                Is Active
                                <input asp-for="MasterValueInContext.IsActive" type="checkbox" />
                                <span class="lever"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col s8 right-align" style="padding-top: 10px;">
                        <button class="btn waves-effect waves-light btnSubmit teal"
                                type="button" name="action">
                            CREATE
                            <i class="material-icons right btnSubmitIcon">send</i>
                        </button>
                        <button class="btn waves-effect waves-light reset red"
                                type="button" name="action">
                            RESET
                        </button>
                    </div>

                    <div class="row col s12 right-align" asp-validation-summary="All"></div>
                </div>
            </form>
            <div class="row"></div>
        </div>
    </div>
</div>

<div id="modal1" class="modal modal-fixed-footer">
    <div class="modal-content">
        <h4>Upload Excel</h4>
        <p>Upload the Excel file that contains all the master values.</p>
        <div class="row hide divErrors">
            <div class="col s12">
                <div class="card-panel red lighten-1">
                    <span class="white-text errors"></span>
                </div>
            </div>
        </div>
        <div class="progress hide">
            <div class="indeterminate"></div>
        </div>
        <form action="UploadExcel" controller="MasterData" method="post">
            <div class="file-field input-field">
                <div class="btn">
                    <span>File</span>
                    <input type="file" id="files">
                </div>
                <div class="file-path-wrapper">
                    <input class="file-path validate" type="text">
                </div>
                <div class="input-field row right">
                    <button class="btn waves-effect waves-light btnUpload teal" type="button" name="action">
                        Upload
                        <i class="material-icons right">send</i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            var token = $('input[type=hidden][name=__RequestVerificationToken]', document).val();
            $.ajaxSetup({
                cache: false,
                headers: { 'RequestVerificationToken': token }
            });

            var table = $('#tblMasterValues').DataTable({
                'ajax': {
                    'url': '@Url.Action("MasterValuesByKey", "MasterData")',
                    'type': 'GET',
                    'dataSrc': function (json) {
                        return json.data || [];
                    }
                },
                'pageLength': 3,
                'lengthMenu': [[3, 5, 10, -1], [3, 5, 10, 'All']],
                'autoWidth': false,
                'columns': [
                    { 'data': 'rowKey' },
                    { 'data': 'partitionKey' },
                    { 'data': 'name' },
                    { 'data': 'isActive' },
                    { 'data': null, 'defaultContent': '' }
                ],
                "aoColumnDefs": [
                    {
                        "aTargets": [3],
                        "mData": "isActive",
                        "mRender": function (data) {
                            return data === true
                                ? '<img src="/images/green_tick.png" />'
                                : '<img src="/images/red_cross.png" />';
                        }
                    },
                    {
                        "aTargets": [4],
                        "mData": null,
                        "mRender": function () {
                            return '<i class="small material-icons edit cursor-hand">mode_edit</i>';
                        }
                    }
                ]
            });

            $('#tblMasterValues').css("width", "100%");

            setTimeout(function () {
                $('select[name="tblMasterValues_length"]').formSelect();
            }, 300);

            $("select[required]").css({ display: "block", position: 'absolute', visibility: 'hidden' });

            $('select').formSelect();

            // Reset button
            $(document).on("click", ".reset", function () {
                $('#formMasterValue')[0].reset();
                $('.btnSubmit').html('CREATE <i class="material-icons right btnSubmitIcon">send</i>');
                $('#IsEdit').val('False');
                $('#Select_MasterValueInContext_PartitionKey').formSelect('destroy');
                $('#Select_MasterValueInContext_PartitionKey').removeAttr('disabled');
                $('#Select_MasterValueInContext_PartitionKey').formSelect();
                $('.validation-summary-valid').find("ul").html('');
                $('#Input_MasterValue_RowKey').val('');
                M.updateTextFields();
            });

            // Edit icon click
            $(document).on('click', '.edit', function () {
                var user = table.row($(this).parents('tr')).data();
                $('#IsEdit').val('True');

                // Row Key
                $('#MasterValueInContext_RowKey').val(user["rowKey"]);
                $('#Input_MasterValue_RowKey').val(user["rowKey"]);

                // Partition Key
                $('#MasterValueInContext_PartitionKey').val(user["partitionKey"]);
                $('#Select_MasterValueInContext_PartitionKey').formSelect('destroy');
                $('#Select_MasterValueInContext_PartitionKey option').filter(function () {
                    return $(this).text() === user['partitionKey'];
                }).prop('selected', true);
                $('#Select_MasterValueInContext_PartitionKey').attr('disabled', 'disabled');
                $('#Select_MasterValueInContext_PartitionKey').formSelect();
                $('.select-wrapper').removeClass('valid');

                // Name
                $('#MasterValueInContext_Name').val(user["name"]);
                $('#MasterValueInContext_Name').addClass('valid');

                // Is Active
                $('#MasterValueInContext_IsActive').prop('checked', user["isActive"] === true);

                // Switch to SAVE mode
                $('.btnSubmit').html('SAVE <i class="material-icons right btnSubmitIcon">save</i>');

                M.updateTextFields();

                // Scroll to form
                $('html, body').animate({ scrollTop: $('#formMasterValue').offset().top - 20 }, 400);
            });

            // Partition Key filter dropdown change
            $(document).on('change', '#ddlMasterKeys', function () {
                var selectedText = $('#ddlMasterKeys option:selected').text();
                table.ajax.url('@Url.Action("MasterValuesByKey", "MasterData")' + '?key=' + selectedText);
                table.ajax.reload();
            });

            // CREATE / SAVE button click
            $(document).on('click', '.btnSubmit', function () {
                var form = $("#formMasterValue");
                if ($(form).valid()) {
                    var masterData = {
                        Name: $('#MasterValueInContext_Name').val(),
                        PartitionKey: $('#Select_MasterValueInContext_PartitionKey option:selected').text(),
                        IsActive: $('#MasterValueInContext_IsActive').is(':checked')
                    };
                    if ($('#IsEdit').val() === 'True') {
                        masterData.RowKey = $('#MasterValueInContext_RowKey').val();
                    }

                    $.post('@Url.Action("MasterValues", "MasterData")',
                        { masterValue: masterData, isEdit: $('#IsEdit').val() },
                        function (response) {
                            if (response === 'Error') {
                                alert("Dữ liệu không hợp lệ. Vui lòng kiểm tra lại.");
                                return;
                            }

                            var key = masterData.PartitionKey;
                            
                            $('#ddlMasterKeys option').filter(function () {
                                return $(this).text() === key;
                            }).prop('selected', true);
                            $('#ddlMasterKeys').formSelect();

                            table.ajax.url('@Url.Action("MasterValuesByKey", "MasterData")' + '?key=' + key);
                            table.ajax.reload();

                            $('.reset').click();
                            $('.select-wrapper').removeClass('valid');
                        }
                    ).fail(function(xhr, status, error) {
                        alert("Đã xảy ra lỗi: " + error + ". (Có thể RowKey này đã tồn tại trong hệ thống!)");
                    });
                }
            });

            // Upload Excel
            $(document).on('click', '.btnUpload', function () {
                var fileUpload = $("#files").get(0);
                var files = fileUpload.files;
                var data = new FormData();
                $.each(files, function (i) {
                    data.append(files[i].name, files[i]);
                });
                $(".progress").removeClass("hide");
                $.ajax({
                    type: "POST",
                    url: "/Configuration/MasterData/UploadExcel",
                    contentType: false,
                    processData: false,
                    data: data,
                    success: function (message) {
                        $(".progress").addClass("hide");
                        if (message.Success) {
                            window.location.reload();
                        }
                        if (message.Error) {
                            $(".divErrors").removeClass("hide");
                            $(".errors").html(message.Text);
                        }
                    },
                    error: function () { }
                });
            });

            $('.modal').modal();
        });
    </script>
}
